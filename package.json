{
  "name": "sound-room",
  "description": "SOUND ROOM bilingual mobile test app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-font": "~58.0.10",
    "expo-gl": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --config rebuild/playwright.config.ts",
    "export:web": "expo export --platform web",
    "start:phone": "expo start --lan",
    "test:e2e": "playwright test --config rebuild/playwright.config.ts",
    "export:native": "expo export --platform android --platform ios",
    "format": "prettier --write App.tsx rebuild/src rebuild/tests",
    "start:lan": "expo start --lan",
    "export:phone-web": "node rebuild/scripts/export-phone-web.cjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
